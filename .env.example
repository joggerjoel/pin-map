# Get a free token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Facebook data import — owner-only "Imports" tab. Points at the fb-import-upload
# (tusd) and fb-import-relay services; see facebook-import-layout-plan.md.
VITE_FB_IMPORT_UPLOAD_URL=http://your-host:8096
VITE_FB_IMPORT_RELAY_URL=http://your-host:8097

# AI photo tagging pipeline (scripts/backfill-photo-tags.ts, scripts/lib/tagPhoto.ts).
# Local-only, not used by the deployed app -- see ai-tagging-plan.md.
# Ollama server for vision tagging (llava) and embeddings (nomic-embed-text).
# Defaults to http://localhost:11434 if unset; point at a remote host running
# Ollama over Tailscale/LAN instead of pulling multi-GB models locally.
OLLAMA_BASE_URL=http://your-ollama-host:11434
