# Get a free token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Facebook data import — owner-only "Imports" tab. Points at the fb-import-upload
# (tusd) and fb-import-relay services; see facebook-import-layout-plan.md.
VITE_FB_IMPORT_UPLOAD_URL=http://your-host:8096
VITE_FB_IMPORT_RELAY_URL=http://your-host:8097
